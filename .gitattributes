# Normalise line endings in the repo; check out LF except for Windows scripts
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
"how to run.txt" text eol=crlf

*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Vendored third-party code: keep byte-for-byte as published (its hash is recorded in its LICENSE file)
public/assets/vendor/** -text
